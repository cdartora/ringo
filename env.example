# Copie para `.env` na raiz do repositório: `cp env.example .env`

# Bot Telegram (apps/bot)
TELEGRAM_BOT_TOKEN=
# URL base do webhook (sem barra no fim), ex.: http://localhost:3000 ou https://seu-servico.run.app
WEBHOOK_URL=http://localhost:3000

# Webhook HTTP (apps/webhook)
PORT=3000
NODE_ENV=development

# Segredo compartilhado bot ↔ webhook: enviar `Authorization: Bearer <valor>`
WEBHOOK_SHARED_SECRET=

# Opcional: IDs do Telegram permitidos (lista separada por vírgula). Vazio = não filtra no stub.
ALLOWED_TELEGRAM_USER_IDS=

# Google Gemini — chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: modelo (omissão gemini-2.5-flash). Se tiveres 404, experimenta gemini-2.0-flash.
# GEMINI_MODEL=gemini-2.5-flash

# Google Sheets — ID da planilha (URL …/spreadsheets/d/<ID>/…)
GOOGLE_SHEETS_SPREADSHEET_ID=

# Caminho absoluto ou relativo à raiz do repo para o JSON da service account
GOOGLE_APPLICATION_CREDENTIALS=
