# Copie para `.env` na raiz do repositório: `cp env.example .env`

# Bot Telegram (apps/bot — futuro)
# TELEGRAM_BOT_TOKEN=

# Webhook HTTP (apps/webhook)
PORT=3000
NODE_ENV=development

# Segredo compartilhado bot ↔ webhook: enviar `Authorization: Bearer <valor>`
WEBHOOK_SHARED_SECRET=

# Opcional: IDs do Telegram permitidos (lista separada por vírgula). Vazio = não filtra no stub.
ALLOWED_TELEGRAM_USER_IDS=

# Google Gemini (próximos passos)
GEMINI_API_KEY=

# Google Sheets — ID da planilha (URL …/spreadsheets/d/<ID>/…)
GOOGLE_SHEETS_SPREADSHEET_ID=

# Caminho absoluto ou relativo à raiz do repo para o JSON da service account
GOOGLE_APPLICATION_CREDENTIALS=
